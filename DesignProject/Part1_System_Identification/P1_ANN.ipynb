    "import numpy as np\n",
    "import torch\n",
    "from pathlib import Path\n",
    "\n",
    "_dir = Path('../gym-unbalanced-disk/disc-benchmark-files')\n",
    "\n",
    "# ── Prediction task ──────────────────────────────────────────────────────────\n",
    "pred_data = np.load(_dir / 'hidden-test-prediction-submission-file.npz')\n",
    "upast_pred  = pred_data['upast']   # (645, 15, 2)\n",
    "thpast_pred = pred_data['thpast']  # (645, 15, 2)\n",
    "y_pred     = pred_data['thnow']   # (645,)\n",
    "X_pred = np.stack([upast_pred, thpast_pred], axis=2)  # (645, 30)\n",
    "X_pred = scaler.transform(X_pred.reshape(-1, X_pred.shape[-1])).reshape(X_pred.shape)  # Scale using the same scaler as before    \n",
    "X_pred = torch.tensor(X_pred, dtype=torch.float32)\n",
    "\n",
    "with torch.no_grad():\n",
    "    Ypredict = best_lstm(X_pred).cpu().numpy() * th_std + th_mean  # Denormalize the predictions\n",
    "\n",
    "assert len(Ypredict)==len(upast_pred), 'number of samples changed!!'\n",
    "np.savez('RNN-predictions.npz', upast=upast_pred, thpast=thpast_pred, thnow=Ypredict)\n",
    "\n",
    "\n",
    "# Fill in Simulation sheet\n",
    "sim_data = np.load(_dir / 'hidden-test-simulation-submission-file.npz')\n",
    "u_test_sim = sim_data['u']\n",
    "th_test_sim = sim_data['th'] #only the first 50 values are filled the rest are zeros\n",
    "\n",
    "\n",
    "\n",
    "Y_simulated = simulate(best_lstm, u_test_sim, th_test_sim, window_size=window_size)\n",
    "assert len(Y_simulated)==len(th_test_sim)\n",
    "np.savez('RNN-simulation.npz', u=u_test_sim, th=Y_simulated)\n"
